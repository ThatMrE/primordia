/* ============================================================
   PRIMORDIA — TYPOGRAPHY
   Two voices: Futura (display + reading), JetBrains Mono (readout).
   Futura: caps + wide tracking for anything that announces;
   light weight, sentence case, left-rag for anything that explains.
   Mono: labels, plate numbers, registers, coordinates. Never body.
   ============================================================ */

:root {
  /* ---------- FACES ---------- */
  --font-futura: 'Futura', 'Futura PT', 'Futura Std', 'Jost', system-ui, sans-serif;
  --font-mono:   'JetBrains Mono', ui-monospace, 'SFMono-Regular', monospace;

  /* ---------- WEIGHTS ---------- */
  --w-light:  300;  /* reading, lede, body @kind font */
  --w-book:   400;  /* @kind font */
  --w-medium: 500;  /* mono labels @kind font */
  --w-bold:   700;  /* display, titles, wordmark @kind font */

  /* ---------- DISPLAY SCALE (Futura, uppercase, tracked) ---------- */
  --t-hero:    clamp(56px, 11vw, 128px); /* hero word @kind font */
  --t-display: clamp(40px, 6vw, 64px);   /* section headline @kind font */
  --t-h1:      clamp(34px, 5vw, 56px); /* @kind font */
  --t-h2:      clamp(28px, 4vw, 40px); /* @kind font */
  --t-h3:      24px; /* @kind font */
  --t-h4:      18px; /* @kind font */

  /* ---------- READING SCALE (Futura, sentence case, light) ---------- */
  --t-lede:  clamp(17px, 2vw, 21px); /* @kind font */
  --t-body:  15px; /* @kind font */
  --t-small: 13px; /* @kind font */

  /* ---------- READOUT SCALE (JetBrains Mono, caps) ---------- */
  --t-mono:    12px; /* @kind font */
  --t-mono-sm: 10px; /* @kind font */

  /* ---------- LINE HEIGHT ---------- */
  --lh-display: 0.92; /* @kind other */
  --lh-tight:   1.05; /* @kind other */
  --lh-body:    1.5; /* @kind other */
  --lh-readout: 1.7; /* @kind other */

  /* ---------- TRACKING ----------
     Wide tracking is structural to the brand. Display caps live
     between 0.03em and 0.28em; the wordmark is 0.26em and must
     never tighten below 0.20em. */
  --tr-hero:    0.05em; /* @kind other */
  --tr-display: 0.03em; /* @kind other */
  --tr-wordmark:0.26em; /* @kind other */
  --tr-thin:    0.22em;  /* light all-caps subheads @kind other */
  --tr-mono:    0.16em; /* @kind other */
  --tr-mono-wide:0.24em; /* @kind other */
}

/* ---------- CANONICAL TYPE RECIPES ---------- */
.disp {
  font-family: var(--font-futura);
  font-weight: var(--w-bold);
  text-transform: uppercase;
  letter-spacing: var(--tr-display);
  line-height: var(--lh-display);
}
.disp-thin {
  font-family: var(--font-futura);
  font-weight: var(--w-light);
  text-transform: uppercase;
  letter-spacing: var(--tr-thin);
  line-height: var(--lh-tight);
}
.lede {
  font-family: var(--font-futura);
  font-weight: var(--w-light);
  font-size: var(--t-lede);
  line-height: var(--lh-body);
  text-wrap: pretty;
}
.body, .p {
  font-family: var(--font-futura);
  font-weight: var(--w-light);
  font-size: var(--t-body);
  line-height: var(--lh-body);
}
.wordmark {
  font-family: var(--font-futura);
  font-weight: var(--w-bold);
  text-transform: uppercase;
  letter-spacing: var(--tr-wordmark);
}
.mono {
  font-family: var(--font-mono);
  font-weight: var(--w-medium);
  font-size: var(--t-mono);
  letter-spacing: var(--tr-mono);
  text-transform: uppercase;
}
